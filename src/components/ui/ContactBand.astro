---
// Slim NAP band. Self-contained band — mirrors FinancingBand's treatment
// (SectionBand surface="contrast" pad="thin") so callers just drop in
// <ContactBand /> with no wrapping required. Separator list items follow the
// TrustBar pattern: gap (token) provides spacing, aria-hidden dot items mark
// the separator rather than a hardcoded-margin ::before character.
import SectionBand from './SectionBand.astro';
---

<SectionBand surface="contrast" width="content" pad="thin">
  <div class="contact-band-inner">
    <ul class="contact-band-list">
      <li class="contact-band-item">Sawtooth Roofing</li>
      <li class="contact-band-item contact-band-sep" aria-hidden="true">&middot;</li>
      <li class="contact-band-item">1560 S Carol St, Meridian, ID 83646</li>
      <li class="contact-band-item contact-band-sep" aria-hidden="true">&middot;</li>
      <li class="contact-band-item">
        <a href="tel:+12089968748" class="contact-band-phone">208.996.8748</a>
      </li>
      <li class="contact-band-item contact-band-sep" aria-hidden="true">&middot;</li>
      <li class="contact-band-item">
        <a href="mailto:contact@sawtooth-roofing.com" class="contact-band-email">contact@sawtooth-roofing.com</a>
      </li>
      <li class="contact-band-item contact-band-sep" aria-hidden="true">&middot;</li>
      <li class="contact-band-item">Open 8:00 AM&ndash;9:00 PM daily</li>
    </ul>
  </div>
</SectionBand>

<style>
  /* Surface and padding are owned by the SectionBand wrapper. */
  .contact-band-inner {
    width: 100%;
  }

  .contact-band-list {
    list-style: none;
    padding: 0;
    margin: 0 auto;
    max-width: 96rem;
    display: flex;
    flex-wrap: wrap;
    flex-direction: column;
    align-items: center;
    gap: var(--space-2xs) var(--space-sm);
    text-align: center;
  }

  @media (min-width: 768px) {
    .contact-band-list {
      flex-direction: row;
      justify-content: center;
    }
  }

  .contact-band-item {
    font-size: 1.3rem;
    color: var(--color-body);
    white-space: nowrap;
  }

  .contact-band-sep {
    display: none;
    color: var(--color-border-strong);
  }

  @media (min-width: 768px) {
    .contact-band-sep {
      display: block;
    }
  }

  .contact-band-phone {
    font-size: 1.4rem;
    font-weight: 700;
    color: var(--color-brand-red);
    text-decoration: none;
  }

  .contact-band-phone:hover {
    color: var(--color-brand-red-hover);
  }

  .contact-band-email {
    color: var(--color-body);
    text-decoration: none;
  }

  .contact-band-email:hover {
    color: var(--color-brand-red);
  }
</style>
