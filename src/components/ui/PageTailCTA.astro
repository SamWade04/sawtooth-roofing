---
// Full-width closing CTA band for pages that don't end on /contact itself.
// Copy reused verbatim from the Home Final-CTA band (index.astro) — no new
// homeowner-facing prose authored here.
import SectionBand from './SectionBand.astro';
---

<SectionBand surface="dark" width="content" pad="band" class="page-tail-cta">
  <div class="final-cta">
    <h2>Think your roof took storm damage?</h2>
    <p>
      A free inspection takes the guesswork out of it. We'll tell you straight whether you've
      got a claim worth filing — and if you do, we'll document it and see the job through.
    </p>
    <div class="final-cta-actions">
      <a href="/contact" class="btn btn--primary">Book a Free Inspection</a>
      <a href="tel:+12089968748" class="btn btn--secondary">Call 208.996.8748</a>
    </div>
  </div>
</SectionBand>

<style>
  /* ── FINAL CTA — copied verbatim from the Home band (index.astro) ── */
  .final-cta h2 {
    margin-bottom: var(--space-sm);
  }

  .final-cta > p {
    max-width: var(--reading-width);
    margin-bottom: 0;
  }

  .final-cta-actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-sm);
    margin-top: var(--space-md);
    flex-direction: column;
    align-items: stretch;
  }

  .final-cta-actions .btn {
    width: 100%;
  }

  @media (min-width: 768px) {
    .final-cta-actions {
      flex-direction: row;
      align-items: center;
    }

    .final-cta-actions .btn {
      width: auto;
    }
  }
</style>
