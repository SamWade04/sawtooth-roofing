    list-style: none;
    padding: 0;
    margin: 0 auto;
    max-width: 96rem;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-xs) var(--space-sm); /* snapped: 0.6rem → 0.8rem, 1.2rem → 1.6rem */
