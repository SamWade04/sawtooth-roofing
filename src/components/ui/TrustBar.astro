---
// §S1 — Trust Bar. Factual only. No manufacturer tier wording.
// F3: verify 83 reviews / 5.0 score against live GBP at publish.
// Surface, padding, and divider are owned by the SectionBand wrapper.
import { GBP_URL } from '../../consts';
---

<div class="trust-bar" aria-label="Trust indicators">
  <ul class="trust-bar-list">
    <li class="trust-bar-item">
      {/* F3: verify count + score against live GBP at publish */}
      <a
        href={GBP_URL}
        target="_blank"
        rel="noopener"
        class="trust-bar-rating"
        aria-label="See our 5.0 rating on Google"
      >
        &#9733; 5.0 from 83 Google reviews
      </a>
    </li>
    <li class="trust-bar-item trust-bar-sep" aria-hidden="true">&middot;</li>
    <li class="trust-bar-item">Owens Corning roofing products</li>
    <li class="trust-bar-item trust-bar-sep" aria-hidden="true">&middot;</li>
    <li class="trust-bar-item">ABC Supply Co. partner</li>
    <li class="trust-bar-item trust-bar-sep" aria-hidden="true">&middot;</li>
    <li class="trust-bar-item">Idaho-registered roofing contractor</li>
    <li class="trust-bar-item trust-bar-sep" aria-hidden="true">&middot;</li>
    <li class="trust-bar-item">Serving the Treasure Valley</li>
  </ul>
</div>

<style>
  /* Surface, padding, and edge borders are owned by the SectionBand wrapper. */
  .trust-bar {
    width: 100%;
  }

  .trust-bar-list {
    list-style: none;
    padding: 0;
    margin: 0 auto;
    max-width: 96rem;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-xs) var(--space-sm);
    align-items: center;
    justify-content: center;
  }

  .trust-bar-item {
    font-size: 1.3rem;
    color: var(--color-body);
    white-space: nowrap;
  }

  .trust-bar-sep {
    color: var(--color-border-strong);
  }

  .trust-bar-rating {
    font-weight: 700;
    color: var(--color-headline);
    text-decoration: none;
  }

  .trust-bar-rating:hover {
    color: var(--color-brand-red);
  }
</style>
