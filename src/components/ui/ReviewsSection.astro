---
// Stage 3b Phase A — build-time-fetched Google reviews, our own markup, no
// runtime third-party script. Replaces the static aggregate-only stat block
// that used to occupy this slot on Home.
//
// Round 4 ruling (Sam): the review count and rating come off the site
// entirely — any published number drifts between deploys. This component no
// longer renders totalReviewCount/averageRating at all; the aggregate is
// still fetched by src/reviews.ts and available to whoever calls this
// component (see index.astro), held for the future A5 schema emitter, which
// needs the real numbers even though the page no longer displays them.
import type { Review } from '../../reviews';

interface Props {
  reviews: Review[];
  profileUrl: string;
}

const { reviews, profileUrl } = Astro.props;

const DISPLAY_COUNT = 12;
const READ_MORE_THRESHOLD = 200; // mirrors Featurable's own config.maxCharacters

const shown = reviews.slice(0, DISPLAY_COUNT);

// Build-time relative date — this page is static, so "3 weeks ago" is only
// as fresh as the last deploy. Matches what the Testimonials Disclosure page
// tells visitors: reviews update periodically, not instantly.
function relativeTime(iso: string): string {
  const then = new Date(iso).getTime();
  const now = Date.now();
  const days = Math.floor((now - then) / 86_400_000);
  if (days < 1) return 'today';
  if (days === 1) return '1 day ago';
  if (days < 30) return `${days} days ago`;
  const months = Math.floor(days / 30);
  if (months < 12) return months === 1 ? '1 month ago' : `${months} months ago`;
  const years = Math.floor(months / 12);
  return years === 1 ? '1 year ago' : `${years} years ago`;
}

function initial(name: string): string {
  return (name.trim().charAt(0) || '?').toUpperCase();
}
---

<div class="reviews-section">
  <a href={profileUrl} target="_blank" rel="noopener" class="reviews-read-all">
    Read all reviews on Google
  </a>

  <p class="reviews-attribution">
    Showing our {shown.length} most recent five-star reviews from Google.
  </p>

  <div class="reviews-slider">
    <button type="button" class="slider-arrow slider-arrow--prev" data-slider-prev aria-label="Previous reviews">
      <svg viewBox="0 0 20 20" width="18" height="18" aria-hidden="true" focusable="false">
        <path d="M12.5 4 L7 10 L12.5 16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
      </svg>
    </button>

    <ul class="reviews-track" data-slider-track>
      {shown.map((review) => {
        const long = review.comment.length > READ_MORE_THRESHOLD;
        return (
          <li class="review-card">
            <div class="review-header">
              {review.profilePhotoUrl ? (
                <img
                  class="review-avatar"
                  src={review.profilePhotoUrl}
                  alt=""
                  width="40"
                  height="40"
                  loading="lazy"
                  referrerpolicy="no-referrer"
                  onerror="this.replaceWith(Object.assign(document.createElement('span'),{className:'review-avatar review-avatar-fallback',textContent:this.dataset.initial}))"
                  data-initial={initial(review.displayName)}
                />
              ) : (
                <span class="review-avatar review-avatar-fallback">{initial(review.displayName)}</span>
              )}
              <div class="review-identity">
                <p class="review-name">{review.displayName}</p>
                <div class="review-stars" aria-label={`${review.starRating} out of 5 stars`}>
                  {Array.from({ length: 5 }).map((_, i) => (
                    <span aria-hidden="true" class={i < review.starRating ? 'star star--on' : 'star'}>&#9733;</span>
                  ))}
                </div>
              </div>
            </div>

            <p class={long ? 'review-text review-text--clamped' : 'review-text'} data-review-text>
              {review.comment}
            </p>
            {long && (
              <button type="button" class="review-read-more" data-review-toggle>
                Read more
              </button>
            )}

            <p class="review-date">{relativeTime(review.createTime)}</p>
          </li>
        );
      })}
    </ul>

    <button type="button" class="slider-arrow slider-arrow--next" data-slider-next aria-label="Next reviews">
      <svg viewBox="0 0 20 20" width="18" height="18" aria-hidden="true" focusable="false">
        <path d="M7.5 4 L13 10 L7.5 16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
      </svg>
    </button>
  </div>
</div>

<script>
  // Progressive enhancement only — every review's full text is already in the
  // DOM (clamped via CSS, not hidden), so this never gates content behind JS.
  document.querySelectorAll<HTMLButtonElement>('[data-review-toggle]').forEach((btn) => {
    btn.addEventListener('click', () => {
      const text = btn.previousElementSibling as HTMLElement | null;
      if (!text) return;
      const expanded = text.classList.toggle('review-text--expanded');
      text.classList.toggle('review-text--clamped', !expanded);
      btn.textContent = expanded ? 'Show less' : 'Read more';
    });
  });

  // Slider arrows — CSS scroll-snap (native touch/swipe, no framework) does
  // the actual sliding; this script only nudges scrollLeft by one card's
  // width per click. Prev/next are real <button> elements, so keyboard focus
  // and :focus-visible work with no extra wiring — see the global
  // :focus-visible registry in global.css for the ring styling.
  document.querySelectorAll<HTMLElement>('.reviews-slider').forEach((slider) => {
    const track = slider.querySelector<HTMLElement>('[data-slider-track]');
    const prev = slider.querySelector<HTMLButtonElement>('[data-slider-prev]');
    const next = slider.querySelector<HTMLButtonElement>('[data-slider-next]');
    if (!track || !prev || !next) return;

    const step = () => {
      const card = track.querySelector<HTMLElement>('.review-card');
      if (!card) return 0;
      const gap = parseFloat(getComputedStyle(track).columnGap || '0');
      return card.getBoundingClientRect().width + gap;
    };

    prev.addEventListener('click', () => track.scrollBy({ left: -step(), behavior: 'smooth' }));
    next.addEventListener('click', () => track.scrollBy({ left: step(), behavior: 'smooth' }));

    // Disable an arrow at each scroll boundary rather than letting it sit
    // there doing nothing once there's nowhere left to scroll.
    const syncDisabled = () => {
      const max = track.scrollWidth - track.clientWidth;
      prev.disabled = track.scrollLeft <= 1;
      next.disabled = track.scrollLeft >= max - 1;
    };
    track.addEventListener('scroll', syncDisabled, { passive: true });
    new ResizeObserver(syncDisabled).observe(track);
    syncDisabled();
  });
</script>

<style>
  .reviews-section {
    text-align: center;
  }

  .reviews-read-all {
    display: inline-block;
    font-size: 1.4rem;
    font-weight: 700;
    color: var(--color-brand-red);
    text-decoration: none;
  }

  .reviews-read-all:hover {
    color: var(--color-brand-red-hover);
  }

  .reviews-attribution {
    margin-top: var(--space-sm);
    font-size: 1.3rem;
    color: var(--color-muted);
  }

  /* ── SLIDER — CSS scroll-snap, no JS carousel framework ──
     Native overflow-x scrolling already keeps horizontal touch drags from
     trapping vertical page scroll (different axes, standard browser
     behavior) — nothing extra needed for that. The prev/next script only
     nudges scrollLeft; snapping, momentum, and touch/swipe are all native. */
  .reviews-slider {
    position: relative;
    margin-top: var(--space-lg);
    padding-inline: 4rem;
  }

  .reviews-track {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    gap: var(--space-sm);
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scroll-behavior: smooth;
    text-align: left;
    /* Scrollbar hidden — the arrows + snap are the intended affordance; the
       track is still a native scroll container, so swipe/trackpad/keyboard
       scroll all keep working regardless. */
    scrollbar-width: none;
  }

  .reviews-track::-webkit-scrollbar {
    display: none;
  }

  /* Mobile (<768px): 1 card visible, swipeable. */
  .review-card {
    flex: 0 0 100%;
    scroll-snap-align: start;
    display: flex;
    flex-direction: column;
    padding: var(--space-md);
    background: var(--color-card);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
  }

  /* Tablet (≥768px): 2 visible. */
  @media (min-width: 768px) {
    .review-card {
      flex: 0 0 calc((100% - var(--space-sm)) / 2);
    }
  }

  /* Desktop (≥1024px): 3 visible. */
  @media (min-width: 1024px) {
    .review-card {
      flex: 0 0 calc((100% - 2 * var(--space-sm)) / 3);
    }
  }

  .slider-arrow {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    display: flex;
    align-items: center;
    justify-content: center;
    width: 3.6rem;
    height: 3.6rem;
    padding: 0;
    background: var(--color-card);
    border: 1px solid var(--color-border);
    border-radius: 50%;
    color: var(--color-headline);
    cursor: pointer;
  }

  .slider-arrow:hover:not(:disabled) {
    border-color: var(--color-border-strong);
    background: var(--color-bg);
  }

  .slider-arrow:disabled {
    opacity: 0.35;
    cursor: default;
  }

  .slider-arrow--prev {
    left: 0;
  }

  .slider-arrow--next {
    right: 0;
  }

  .review-header {
    display: flex;
    align-items: center;
    gap: var(--space-xs);
  }

  .review-avatar {
    flex-shrink: 0;
    width: 4.0rem;
    height: 4.0rem;
    border-radius: 50%;
    object-fit: cover;
  }

  .review-avatar-fallback {
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--color-headline);
    color: var(--color-bg);
    font-weight: 700;
    font-size: 1.5rem;
  }

  .review-identity {
    min-width: 0;
  }

  .review-name {
    font-weight: 700;
    font-size: 1.4rem;
    color: var(--color-headline);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .review-stars {
    font-size: 1.2rem;
    line-height: 1;
    color: var(--color-border-strong);
    margin-top: var(--space-2xs);
  }

  .star--on {
    color: var(--color-headline);
  }

  .review-text {
    margin-top: var(--space-sm);
    font-size: 1.4rem;
    color: var(--color-body);
  }

  .review-text--clamped {
    display: -webkit-box;
    -webkit-line-clamp: 4;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .review-read-more {
    align-self: flex-start;
    margin-top: var(--space-xs);
    padding: 0;
    background: none;
    border: 0;
    font-size: 1.3rem;
    font-weight: 700;
    color: var(--color-brand-red);
    cursor: pointer;
  }

  .review-read-more:hover {
    color: var(--color-brand-red-hover);
  }

  .review-date {
    margin-top: auto;
    padding-top: var(--space-sm);
    font-size: 1.2rem;
    color: var(--color-muted);
  }
</style>
