---
// Full-bleed photo page-header band (Stage 3b Round 1 ruling: 0.78 dark
// overlay, centered H1 only, 400px min-height — see --hero-overlay /
// --hero-min-h in tokens.css). Shared by ContentPageLayout and About.
//
// Stage 3b Round 2 extends this for the Home hero: when `heading` is
// omitted, the default slot renders instead — letting a consumer supply its
// own two-column content (headline/lead + a form card) rather than the
// centered-H1-only layout. `overlayToken` swaps in a different named token
// (e.g. --hero-overlay-light) without forking the composition into a
// sibling component.
import type { ImageMetadata } from 'astro';
import { Picture } from 'astro:assets';

interface Props {
  image: ImageMetadata;
  alt: string;
  heading?: string;
  overlayToken?: string; // CSS custom property name; defaults to --hero-overlay
}

const { image, alt, heading, overlayToken } = Astro.props;
const style = overlayToken ? `--hero-overlay: var(${overlayToken})` : undefined;
---

<section class="band--dark hero-photo-band" style={style}>
  <div class="hero-photo-media">
    <Picture
      src={image}
      alt={alt}
      formats={['avif', 'webp']}
      fallbackFormat="jpeg"
      widths={[640, 960, 1280, 1672]}
      sizes="100vw"
      loading="eager"
      decoding="async"
      fetchpriority="high"
    />
  </div>
  <div class="hero-photo-overlay"></div>
  <div class={`hero-photo-inner ${heading ? 'hero-photo-inner--center' : ''}`}>
    {heading ? <h1>{heading}</h1> : <slot />}
  </div>
</section>

<style>
  .hero-photo-band {
    position: relative;
    display: flex;
    align-items: center;
    overflow: hidden;
    min-height: calc(var(--hero-min-h) * 0.72);
  }

  @media (min-width: 768px) {
    .hero-photo-band {
      min-height: var(--hero-min-h);
    }
  }

  .hero-photo-media {
    position: absolute;
    inset: 0;
  }

  /* img is absolutely positioned directly (not just 100%/100%) because the
     <picture> wrapper has no explicit height of its own — a percentage height
     on img alone falls back to the width/height HTML attrs' intrinsic ratio,
     letting the photo overflow past the band and get silently clipped. */
  .hero-photo-media :global(img) {
    position: absolute;
    inset: 0;
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .hero-photo-overlay {
    position: absolute;
    inset: 0;
    background: rgba(15, 23, 42, var(--hero-overlay)); /* --color-headline at --hero-overlay */
  }

  .hero-photo-inner {
    position: relative;
    z-index: 1;
    width: 100%;
    max-width: var(--content-max);
    margin: 0 auto;
    padding-inline: var(--gutter);
    /* same vertical rhythm as SectionBand's pad="band" — this band doesn't
       route through SectionBand, so it can't inherit .band--pad-band */
    padding-block: var(--space-xl);
  }

  .hero-photo-inner--center {
    text-align: center;
  }

  @media (min-width: 768px) {
    .hero-photo-inner {
      padding-inline: var(--gutter-lg);
      padding-block: var(--space-2xl);
    }
  }

  .hero-photo-band h1 {
    margin: 0;
  }
</style>
