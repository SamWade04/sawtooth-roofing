---
// Sticky mobile tel: CTA — phone stays the primary conversion path below 768px,
// where the sticky desktop header (Header.astro) doesn't apply.
---

<a href="tel:+12089968748" class="mobile-call-bar" aria-label="Call Sawtooth Roofing at 208.996.8748">
  <svg class="mobile-call-bar-icon" viewBox="0 0 20 20" width="18" height="18" aria-hidden="true" focusable="false">
    <path
      d="M2 3a1.5 1.5 0 0 1 1.5-1.5h1.8c.6 0 1.1.4 1.3 1l.9 2.7a1.5 1.5 0 0 1-.4 1.6L6 7.8c.9 1.8 2.4 3.3 4.2 4.2l1-1.1a1.5 1.5 0 0 1 1.6-.4l2.7.9c.6.2 1 .7 1 1.3v1.8A1.5 1.5 0 0 1 15 16C7.8 16 2 10.2 2 3Z"
      fill="currentColor"
    />
  </svg>
  <span>Call 208.996.8748</span>
</a>

<script>
  const bar = document.querySelector<HTMLElement>('.mobile-call-bar');

  // Bar height varies with content/viewport — measure rather than hardcode,
  // so body/footer padding stays accurate (mirrors Header.astro's approach).
  if (bar) {
    const setBarHeightVar = () => {
      document.documentElement.style.setProperty('--mobile-call-bar-height', `${bar.offsetHeight}px`);
    };
    setBarHeightVar();
    new ResizeObserver(setBarHeightVar).observe(bar);
  }
</script>

<style>
  .mobile-call-bar {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-xs);
    position: fixed;
    left: 0;
    right: 0;
    bottom: 0;
    z-index: 40;
    min-height: 4.8rem;
    padding: var(--space-sm) var(--space-md) calc(var(--space-sm) + env(safe-area-inset-bottom));
    background: var(--color-brand-red);
    color: var(--color-card);
    font-size: 1.6rem;
    font-weight: 700;
    text-decoration: none;
  }

  .mobile-call-bar:hover {
    background: var(--color-brand-red-hover);
  }

  .mobile-call-bar-icon {
    flex-shrink: 0;
  }

  @media (min-width: 768px) {
    .mobile-call-bar {
      display: none;
    }
  }
</style>
