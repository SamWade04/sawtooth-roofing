---
import { HEARTH_FINANCING_URL } from '../../consts';

// Financing is interim: it points straight at the lending partner's
// application, external and marked as such. A real /financing page is
// planned but deliberately deferred — publishing specific rates, APRs, or
// payment figures on our own page triggers Truth in Lending / Regulation Z
// disclosure obligations that a bare link-out does not.
const navLinks = [
  { label: 'Services',   href: '/services'  },
  { label: 'Locations',  href: '/locations' },
  { label: 'About',      href: '/about'     },
  { label: 'Contact',    href: '/contact'   },
  { label: 'Financing',  href: HEARTH_FINANCING_URL, external: true },
];
---

<header class="site-header">
  <div class="header-inner">

    <!-- Logo lockup — links to home, NOT an h1.
         Roof mark: cropped directly from the brand lockup PNG
         (sawtooth-logo-horizontal.png, Assets/Logo) — just the sawtooth
         roofline glyph, trimmed to its alpha bounding box, native gray,
         transparent background. The "SAWTOOTH ROOFING" lettering stays live
         text in .wordmark, not part of the image. Decorative: alt="" since
         the parent link's aria-label carries the accessible name. -->
    <a href="/" class="logo" aria-label="Sawtooth Roofing — home">
      <img
        src="/logo-mark.png"
        srcset="/logo-mark.png 1x, /logo-mark@2x.png 2x"
        width="74"
        height="25"
        alt=""
        class="logo-mark"
      />
      <!-- WORDMARK TEST (Stage 3b Round 2 amendment, item 7) — Sam's gate
           judgment call, one commit, trivially revertible: swap the
           `<span class="wordmark">` back in and delete public/wordmark-test.png
           to revert. ai-wordmark-test-01.png, letterforms inspected clean. -->
      <img
        src="/wordmark-test.png"
        width="1180"
        height="76"
        alt="Sawtooth Roofing"
        class="wordmark-test-img"
      />
    </a>

    <!-- Phone CTA — always visible (not behind toggle) -->
    <a href="tel:+12089968748" class="phone-cta">
      <svg class="phone-icon" viewBox="0 0 20 20" width="16" height="16" aria-hidden="true" focusable="false">
        <path
          d="M2 3a1.5 1.5 0 0 1 1.5-1.5h1.8c.6 0 1.1.4 1.3 1l.9 2.7a1.5 1.5 0 0 1-.4 1.6L6 7.8c.9 1.8 2.4 3.3 4.2 4.2l1-1.1a1.5 1.5 0 0 1 1.6-.4l2.7.9c.6.2 1 .7 1 1.3v1.8A1.5 1.5 0 0 1 15 16C7.8 16 2 10.2 2 3Z"
          fill="currentColor"
        />
      </svg>
      <span>208.996.8748</span>
    </a>

    <!-- Mobile menu toggle -->
    <button
      class="nav-toggle"
      aria-expanded="false"
      aria-controls="primary-nav"
      aria-label="Menu"
    >
      <span class="burger" aria-hidden="true"></span>
    </button>

    <!-- Primary nav — 5 items -->
    <nav id="primary-nav" class="primary-nav" aria-label="Primary navigation">
      {navLinks.map(({ label, href, external }) => (
        <a
          href={href}
          class="nav-link"
          target={external ? '_blank' : undefined}
          rel={external ? 'noopener noreferrer' : undefined}
        >
          {label}
        </a>
      ))}
    </nav>

  </div>
</header>

<script>
  const toggle = document.querySelector<HTMLButtonElement>('.nav-toggle');
  const nav    = document.getElementById('primary-nav');
  const header = document.querySelector<HTMLElement>('.site-header');

  toggle?.addEventListener('click', () => {
    const expanded = toggle.getAttribute('aria-expanded') === 'true';
    toggle.setAttribute('aria-expanded', String(!expanded));
    nav?.setAttribute('data-open', String(!expanded));
  });

  // Sticky header height varies with content/viewport — measure rather than
  // hardcode, so in-page anchor jumps (scroll-padding-top) stay accurate.
  if (header) {
    const setHeaderHeightVar = () => {
      document.documentElement.style.setProperty('--header-height', `${header.offsetHeight}px`);
    };
    setHeaderHeightVar();
    new ResizeObserver(setHeaderHeightVar).observe(header);
  }
</script>

<style>
  .site-header {
    background: var(--color-card);
    border-bottom: 1px solid var(--color-border);
  }

  .header-inner {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
    max-width: 120rem;
    margin: 0 auto;
    padding: var(--space-sm) var(--space-md);
    flex-wrap: wrap;
  }

  /* ── Logo ── */
  .logo {
    display: inline-flex;
    align-items: center;
    gap: var(--space-xs);
    text-decoration: none;
    flex-shrink: 0;
  }

  .logo-mark {
    flex-shrink: 0;
  }

  .wordmark {
    font-weight: 700;
    font-size: 1.6rem;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--color-headline);
    white-space: nowrap;
  }

  /* WORDMARK TEST — sized to the live-text wordmark's rendered height */
  /* Mobile-first: this display face runs much wider per unit height than
     the live-text wordmark it replaces, so matching the text's cap-height
     directly overflowed a 375px header. Sized instead to roughly the same
     rendered WIDTH the text wordmark had (~146px at 375px, verified in
     PR #20); desktop gets the taller, more legible size since there's
     ample room there. */
  .wordmark-test-img {
    height: 0.9rem;
    width: auto;
    flex-shrink: 0;
  }

  /* ── Phone CTA — desktop only ──
     Hidden below 768px (Sam's phone review): the logo lockup + number could not
     share a 375px row, so the number wrapped and doubled the header's height —
     and it duplicated the sticky bottom call bar, putting the same number on
     screen twice at all times. Mobile keeps the call bar as its call path.
     Desktop is unchanged and still shows it: there is no call bar at that
     width, so the header number is desktop's primary call path. */
  .phone-cta {
    display: none;
    align-items: center;
    gap: var(--space-2xs); /* off-scale — flag: 0.5rem snapped from original */
    text-decoration: none;
    font-size: 1.4rem;
    font-weight: 700;
    color: var(--color-brand-red);
    white-space: nowrap;
  }

  .phone-cta:hover {
    color: var(--color-brand-red-hover);
  }

  .phone-icon {
    flex-shrink: 0;
  }

  /* ── Mobile toggle ── */
  .nav-toggle {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 4rem;
    height: 4rem;
    padding: 0;
    background: transparent;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    cursor: pointer;
    color: var(--color-headline);
    flex-shrink: 0;
    /* Carries the right-alignment that .phone-cta's margin-left:auto used to
       provide before the number went desktop-only — without it the toggle
       would collapse against the logo and leave the row's right edge empty. */
    margin-left: auto;
  }

  .nav-toggle:hover {
    background: var(--color-bg);
  }

  /* Hamburger icon drawn in CSS */
  .burger,
  .burger::before,
  .burger::after {
    display: block;
    width: 1.8rem;
    height: 0.2rem;
    background: currentColor;
    border-radius: var(--radius-xs);
    transition: transform var(--duration-base) var(--ease), opacity var(--duration-base) var(--ease);
    position: relative;
  }

  .burger::before,
  .burger::after {
    content: '';
    position: absolute;
    left: 0;
  }

  .burger::before { top: -0.6rem; }
  .burger::after  { top:  0.6rem; }

  /* Toggle open state — X mark */
  [aria-expanded="true"] .burger {
    background: transparent;
  }

  [aria-expanded="true"] .burger::before {
    transform: translateY(0.6rem) rotate(45deg);
  }

  [aria-expanded="true"] .burger::after {
    transform: translateY(-0.6rem) rotate(-45deg);
  }

  /* ── Primary nav — mobile (hidden, shown when open) ── */
  .primary-nav {
    display: none;
    flex-direction: column;
    width: 100%;
    order: 99;
    padding: var(--space-xs) 0 var(--space-sm);
    border-top: 1px solid var(--color-border);
  }

  .primary-nav[data-open="true"] {
    display: flex;
  }

  .nav-link {
    padding: var(--space-xs) var(--space-2xs);
    font-size: 1.5rem;
    font-weight: 600;
    text-decoration: none;
    color: var(--color-headline);
    border-bottom: 1px solid var(--color-border);
  }

  .nav-link:last-child {
    border-bottom: none;
  }

  .nav-link:hover {
    color: var(--color-brand-red);
  }

  /* ── Desktop (≥768px) ── */
  @media (min-width: 768px) {
    .site-header {
      position: sticky;
      top: 0;
      z-index: 40;
    }

    .wordmark-test-img {
      height: 1.8rem;
    }

    .nav-toggle {
      display: none;
    }

    .primary-nav {
      display: flex;
      flex-direction: row;
      align-items: center;
      gap: var(--space-2xs);
      width: auto;
      order: unset;
      padding: 0;
      border-top: none;
      margin-left: auto;
    }

    /* Restored here — desktop order stays logo | nav | phone, unchanged. */
    .phone-cta {
      display: inline-flex;
      margin-left: var(--space-sm);
    }

    .nav-link {
      padding: var(--space-xs) var(--space-xs);
      font-size: 1.4rem;
      border-bottom: none;
      border-radius: var(--radius-sm);
    }

    .nav-link:hover {
      background: var(--color-bg);
    }
  }
</style>
