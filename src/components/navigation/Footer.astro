---
const year = new Date().getFullYear();

const serviceAreas = [
  { city: 'Nampa',    href: '/locations/nampa'    },
  { city: 'Caldwell', href: '/locations/caldwell' },
  { city: 'Meridian', href: '/locations/meridian' },
  { city: 'Boise',    href: '/locations/boise'    },
  { city: 'Kuna',     href: '/locations/kuna'     },
];

const footerLinks = [
  { label: 'Services',        href: '/services'  },
  { label: 'Locations',       href: '/locations' },
  { label: 'Portfolio',       href: '/portfolio' },
  { label: 'About',           href: '/about'     },
  { label: 'Contact',         href: '/contact'   },
  { label: 'Blog',            href: '/blog'      },
  { label: 'Privacy Policy',  href: '/privacy'   },
];
---

<footer class="site-footer">
  <div class="footer-inner">

    <!-- NAP block -->
    <div class="footer-nap">
      <p class="footer-brand">Sawtooth Roofing</p>
      <address class="footer-address">
        1560 S Carol St<br />Meridian, ID 83646
      </address>
      <a href="tel:+12089968748" class="footer-phone">208.996.8748</a>
    </div>

    <!-- Service areas -->
    <div class="footer-section">
      <p class="footer-section-heading">Service Areas</p>
      <ul class="footer-city-list">
        {serviceAreas.map(({ city, href }) => (
          <li><a href={href} class="footer-link">{city}</a></li>
        ))}
      </ul>
    </div>

    <!-- Footer links row -->
    <div class="footer-section footer-section--links">
      <p class="footer-section-heading">Quick Links</p>
      <ul class="footer-link-list">
        {footerLinks.map(({ label, href }) => (
          <li><a href={href} class="footer-link">{label}</a></li>
        ))}
      </ul>
    </div>

  </div>

  <!-- Legal bar -->
  <div class="footer-legal-bar">
    <p class="footer-legal">
      &copy; {year} Sawtooth Roofing &amp; Construction LLC
    </p>
    {/* F1 LAUNCH GATE: real RCE-##### must be sourced from DOPL before launch — see doc 30 §2 */}
    <p class="footer-legal footer-license-placeholder">
      Idaho Contractor Reg. #: [RCE-##### — PENDING DOPL]
    </p>
  </div>
</footer>

<style>
  .site-footer {
    background: var(--color-bg);
    border-top: 1px solid var(--color-border);
    margin-top: auto;
  }

  .footer-inner {
    display: grid;
    grid-template-columns: 1fr;
    gap: 3.2rem;
    max-width: 120rem;
    margin: 0 auto;
    padding: 4rem 2.4rem 3.2rem;
  }

  @media (min-width: 768px) {
    .footer-inner {
      grid-template-columns: 1.5fr 1fr 1.5fr;
      gap: 4rem;
    }
  }

  /* ── NAP block ── */
  .footer-brand {
    font-weight: 700;
    font-size: 1.6rem;
    color: var(--color-headline);
    margin-bottom: 0.8rem;
  }

  .footer-address {
    font-style: normal;
    font-size: 1.4rem;
    color: var(--color-body);
    line-height: 1.6;
    margin-bottom: 0.8rem;
  }

  .footer-phone {
    font-size: 1.4rem;
    font-weight: 600;
    color: var(--color-brand-red);
    text-decoration: none;
  }

  .footer-phone:hover {
    color: var(--color-brand-red-hover);
  }

  /* ── Section headings ── */
  .footer-section-heading {
    font-size: 1.3rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-headline);
    margin-bottom: 1.2rem;
  }

  /* ── City list ── */
  .footer-city-list,
  .footer-link-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }

  .footer-link {
    font-size: 1.4rem;
    color: var(--color-body);
    text-decoration: none;
  }

  .footer-link:hover {
    color: var(--color-brand-red);
  }

  /* ── Quick links — 2-col grid on mobile to save vertical space ── */
  .footer-section--links .footer-link-list {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.6rem 1.6rem;
  }

  @media (min-width: 768px) {
    .footer-section--links .footer-link-list {
      grid-template-columns: 1fr;
    }
  }

  /* ── Legal bar ── */
  .footer-legal-bar {
    border-top: 1px solid var(--color-border);
    max-width: 120rem;
    margin: 0 auto;
    padding: 2rem 2.4rem;
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 2.4rem;
    align-items: center;
  }

  .footer-legal {
    font-size: 1.2rem;
    color: var(--color-muted);
    margin: 0;
  }

  /* Visually distinct so the placeholder cannot be confused for a real license number */
  .footer-license-placeholder {
    color: var(--color-muted);
    font-style: italic;
  }
</style>
