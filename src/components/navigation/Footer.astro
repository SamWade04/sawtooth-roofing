---
import { getCollection } from 'astro:content';
import { HEARTH_FINANCING_URL } from '../../consts';

// §S3 — Footer NAP + legal line.
const year = new Date().getFullYear();

// Round 4 restructure: Quick Links had grown to 9 items and the footer was
// too tall — split into three link columns (Bartlett is a reference, not a
// template; groupings below are this implementer's call, reported at the
// gate). Legal links moved into the bottom bar as inline links, alongside
// the unchanged copyright/registration line.

// SERVICES — a deliberately curated, explicitly-ordered list (matching the
// dispatch text), same precedent as Home's own service-tile grid (doc 11 +
// doc 30 §1/§3(b)/§6 hardcode 3 canonical slugs rather than dumping the
// collection) — NOT collection-driven. "Locations" dropped from this column;
// city links live in Service Areas already, and the hub link belongs there.
const serviceLinks = [
  { label: 'Roof Replacement',          href: '/services/roof-replacement' },
  { label: 'Roof Repair',               href: '/services/roof-repair' },
  { label: 'Storm Damage Restoration',  href: '/services/storm-damage-restoration' },
  { label: 'Services',                  href: '/services' },
];

// COMPANY — Financing is interim (see Header.astro note) — external, marked
// as such, sharing the one HEARTH_FINANCING_URL definition.
const companyLinks = [
  { label: 'About',      href: '/about'    },
  { label: 'Portfolio',  href: '/portfolio' },
  { label: 'Contact',    href: '/contact'  },
  { label: 'Financing',  href: HEARTH_FINANCING_URL, external: true },
  { label: 'Blog',       href: '/blog'     },
];

// SERVICE AREAS — collection-driven, draft-aware, unchanged from before this
// restructure — do NOT hardcode. Mirrors the /locations hub pattern.
// draft:true cities render as plain text (no 404), draft:false auto-link.
const serviceAreas = (await getCollection('locations')).sort(
  (a, b) => a.data.order - b.data.order
);
---

<footer class="site-footer">
  <div class="footer-inner">

    <!-- §S3 NAP block — must match GBP + schema exactly -->
    <div class="footer-nap">
      <p class="footer-brand">Sawtooth Roofing</p>
      <address class="footer-address">
        1560 S Carol St<br />Meridian, ID 83646
      </address>
      <a href="tel:+12089968748" class="footer-phone">208.996.8748</a>
      <a href="mailto:contact@sawtooth-roofing.com" class="footer-email">
        contact@sawtooth-roofing.com
      </a>
      <p class="footer-service-area-text">
        Serving Nampa, Caldwell, Meridian, Boise &amp; Kuna and the greater Treasure Valley.
      </p>
    </div>

    <!-- Column 2: SERVICES -->
    <div class="footer-section">
      <p class="footer-section-heading">Services</p>
      <ul class="footer-link-list">
        {serviceLinks.map(({ label, href }) => (
          <li><a href={href} class="footer-link">{label}</a></li>
        ))}
      </ul>
    </div>

    <!-- Column 3: SERVICE AREAS — collection-driven, unchanged -->
    <div class="footer-section">
      <p class="footer-section-heading">Service Areas</p>
      <ul class="footer-city-list">
        {serviceAreas.map((location) => (
          <li>
            {location.data.draft ? (
              <span class="footer-city-text">{location.data.city}</span>
            ) : (
              <a href={`/locations/${location.id}`} class="footer-link">{location.data.city}</a>
            )}
          </li>
        ))}
      </ul>
    </div>

    <!-- Column 4: COMPANY -->
    <div class="footer-section">
      <p class="footer-section-heading">Company</p>
      <ul class="footer-link-list">
        {companyLinks.map(({ label, href, external }) => (
          <li>
            <a
              href={href}
              class="footer-link"
              target={external ? '_blank' : undefined}
              rel={external ? 'noopener noreferrer' : undefined}
            >
              {label}
            </a>
          </li>
        ))}
      </ul>
    </div>

  </div>

  <!-- §S3 Legal bar — copyright + registration number UNCHANGED (F1 legal
       gate), now followed by the three legal pages as inline links. -->
  <div class="footer-legal-bar">
    <p class="footer-legal">
      &copy; {year} Sawtooth Roofing &amp; Construction LLC
    </p>
    <p class="footer-legal footer-license-placeholder">
      Idaho-registered roofing contractor #7371651
    </p>
    <nav class="footer-legal-links" aria-label="Legal">
      <a href="/privacy" class="footer-legal-link">Privacy Policy</a>
      <span aria-hidden="true" class="footer-legal-sep">&middot;</span>
      <a href="/terms" class="footer-legal-link">Terms of Use</a>
      <span aria-hidden="true" class="footer-legal-sep">&middot;</span>
      <a href="/testimonials-disclosure" class="footer-legal-link">Testimonials Disclosure</a>
    </nav>
  </div>
</footer>

<style>
  .site-footer {
    background: var(--color-bg);
    border-top: 1px solid var(--color-border);
    margin-top: auto;
  }

  .footer-inner {
    display: grid;
    grid-template-columns: 1fr;
    /* Round 4: 4 stacked sections now instead of 3 (Services split out of the
       old combined Quick Links), so the full space-lg gap between EVERY
       section at mobile — where everything stacks into one column regardless
       of the desktop column split — added one extra gap's worth of height
       and made the "footer too tall" problem worse there even as it fixed
       desktop. space-md at mobile keeps that in check; desktop gets the
       wider gap back below, where there's no stacking penalty. */
    gap: var(--space-md);
    max-width: 120rem;
    margin: 0 auto;
    padding: var(--space-lg) var(--space-md) var(--space-lg);
  }

  @media (min-width: 768px) {
    .footer-inner {
      /* 4 columns now (brand + Services + Service Areas + Company) — brand
         stays widest since it carries address/phone/email, the three link
         columns split the rest evenly. */
      grid-template-columns: 1.6fr 1fr 1fr 1fr;
      gap: var(--space-lg);
    }
  }

  /* ── NAP block ── */
  .footer-brand {
    font-weight: 700;
    font-size: 1.6rem;
    color: var(--color-headline);
    margin-bottom: var(--space-xs);
  }

  .footer-address {
    font-style: normal;
    font-size: 1.4rem;
    color: var(--color-body);
    line-height: 1.6;
    margin-bottom: var(--space-xs);
  }

  .footer-phone {
    display: block;
    font-size: 1.4rem;
    font-weight: 600;
    color: var(--color-brand-red);
    text-decoration: none;
    margin-bottom: var(--space-2xs);
  }

  .footer-phone:hover {
    color: var(--color-brand-red-hover);
  }

  .footer-email {
    display: block;
    font-size: 1.3rem;
    color: var(--color-body);
    text-decoration: none;
    margin-bottom: var(--space-sm); /* snapped: 1.2rem → 1.6rem */
  }

  .footer-email:hover {
    color: var(--color-brand-red);
  }

  .footer-service-area-text {
    font-size: 1.3rem;
    color: var(--color-muted);
    line-height: 1.5;
  }

  /* ── Section headings ── */
  .footer-section-heading {
    font-size: 1.3rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-headline);
    margin-bottom: var(--space-sm); /* snapped: 1.2rem → 1.6rem */
  }

  /* ── City list + Services/Company link lists ──
     2-col on mobile to save vertical space (Round 4: now 3 short columns
     instead of 1 long one, so this matters for all of them, not just the
     old combined Quick Links); single column once there's room at ≥768px. */
  .footer-city-list,
  .footer-link-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-xs) var(--space-sm); /* snapped: 0.6rem → 0.8rem */
  }

  @media (min-width: 768px) {
    .footer-city-list,
    .footer-link-list {
      grid-template-columns: 1fr;
    }
  }

  /* Shared box: .footer-city-text (draft city, no link) matches .footer-link
     visually minus the link affordance — same technique as the /locations hub. */
  .footer-link,
  .footer-city-text {
    font-size: 1.4rem;
    color: var(--color-body);
    text-decoration: none;
  }

  .footer-link:hover {
    color: var(--color-brand-red);
  }

  /* ── Legal bar ── */
  .footer-legal-bar {
    border-top: 1px solid var(--color-border);
    max-width: 120rem;
    margin: 0 auto;
    padding: var(--space-md) var(--space-md); /* snapped: 2.0rem → 2.4rem */
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2xs) var(--space-md);
    align-items: center;
  }

  .footer-legal {
    font-size: 1.2rem;
    color: var(--color-muted);
    margin: 0;
  }

  /* Visually distinct so placeholder cannot be confused for a real license number */
  .footer-license-placeholder {
    font-style: italic;
  }

  /* Privacy / Terms / Testimonials Disclosure — moved into the bottom bar
     as inline links (Round 4 footer restructure), same row as the
     copyright + registration line rather than their own Quick Links slot. */
  .footer-legal-links {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2xs);
  }

  .footer-legal-link {
    font-size: 1.2rem;
    color: var(--color-muted);
    text-decoration: none;
  }

  .footer-legal-link:hover {
    color: var(--color-brand-red);
  }

  .footer-legal-sep {
    color: var(--color-border-strong);
    font-size: 1.2rem;
  }
</style>
