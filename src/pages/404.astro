---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Page not found — Sawtooth Roofing">
  <main style="max-width: 72rem; margin: var(--space-2xl) auto; padding: 0 var(--space-md); text-align: center;">
    <h1>404 — Page Not Found</h1>
    <p class="lead" style="margin-top: var(--space-sm);">
      That page doesn't exist or may have moved.
    </p>
    <p style="margin-top: var(--space-md);">
      <a href="/" style="color: var(--color-brand-red); font-weight: 700;">Back to home</a>
    </p>
  </main>
</BaseLayout>
