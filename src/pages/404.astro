---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionBand from '../components/ui/SectionBand.astro';
---

<BaseLayout title="Page not found — Sawtooth Roofing">
  <main class="not-found">
    <SectionBand surface="light" width="reading" pad="band">
      <h1>404 — Page Not Found</h1>
      <p class="lead">
        That page doesn't exist or may have moved.
      </p>
      <p class="not-found-home">
        <a href="/">Back to home</a>
      </p>
    </SectionBand>
  </main>
</BaseLayout>

<style>
  .not-found {
    text-align: center;
  }

  .not-found .lead {
    margin-top: var(--space-sm);
  }

  .not-found-home {
    margin-top: var(--space-md);
  }

  .not-found-home a {
    color: var(--color-brand-red);
    font-weight: 700;
  }
</style>
