---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import SectionBand from '../../components/ui/SectionBand.astro';

const locations = (await getCollection('locations')).sort(
  (a, b) => a.data.order - b.data.order
);
---

<BaseLayout
  title="Service Areas — Roofing in Nampa, Caldwell, Meridian, Boise & Kuna | Sawtooth Roofing"
  description="Sawtooth Roofing serves the Treasure Valley from Meridian — storm damage restoration, roof replacement & repair across Nampa, Caldwell, Meridian, Boise & Kuna. Free inspections."
>
  <!-- main.locations-hub is a plain flow container; bands own all width/padding/surface -->
  <main class="locations-hub">

    <SectionBand surface="dark" width="content" pad="band">
      <h1>Where We Work</h1>
      <p class="lead u-reading">
        Sawtooth Roofing serves homeowners across the Treasure Valley from our Meridian base — Nampa, Caldwell, Meridian, Boise, and Kuna. Storm damage, insurance restoration, roof replacement, or roof repair: wherever you are in the valley, we inspect free, document thoroughly, and build to manufacturer spec with products.
      </p>
      <p class="hero-cta u-reading">
        Storm just moved through your neighborhood? <a href="/contact">Book a free roof inspection</a> — we'll tell you exactly where your roof stands, in writing.
      </p>
    </SectionBand>

    <SectionBand surface="light" width="content" pad="band">
      <ul class="city-grid">
        {
          locations.map((location) =>
            location.data.draft ? (
              /* City pages gated (F6) — non-linked cards until per-city content clears */
              <li class="city-card">
                <div class="city-card-body">
                  <span class="coming-soon-badge">Coming soon</span>
                  <h2>{location.data.city}</h2>
                </div>
              </li>
            ) : (
              <li class="city-card">
                <a href={`/locations/${location.id}`} class="city-card-link">
                  <h2>{location.data.city}</h2>
                  <span class="city-card-cta">Learn more &rarr;</span>
                </a>
              </li>
            )
          )
        }
      </ul>
    </SectionBand>

  </main>
</BaseLayout>

<style>
  .lead {
    margin-top: var(--space-sm);
  }

  .hero-cta {
    margin-top: var(--space-sm);
  }

  /* On-dark inline link — brand red fails contrast on --color-headline; use light tone */
  .hero-cta a {
    color: var(--color-bg);
    font-weight: 700;
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  .city-grid {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-sm);
  }

  @media (min-width: 768px) {
    .city-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  .city-card {
    display: flex;
  }

  /* Shared card box; .city-card-body (draft) adds the dimmed non-interactive
     treatment, .city-card-link (published) adds the /services hover-lift */
  .city-card-body,
  .city-card-link {
    display: block;
    width: 100%;
    padding: var(--space-md);
    background: var(--color-card);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
  }

  /* Same dimmed, non-interactive treatment as the /services DRAFT card */
  .city-card-body {
    opacity: 0.6;
    cursor: default;
    pointer-events: none;
  }

  /* Hover-lift scoped to linked cards; compositor-only props; zero CLS */
  .city-card-link {
    text-decoration: none;
    transition: transform var(--duration-base) var(--ease-out),
                box-shadow var(--duration-base) var(--ease-out),
                border-color var(--duration-base) var(--ease-out);
  }

  .city-card-link:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow-lg);
    border-color: var(--color-border-strong);
  }

  .city-card-link:focus-visible {
    outline: 2px solid var(--color-brand-red);
    outline-offset: 2px;
  }

  .city-card-cta {
    display: inline-block;
    margin-top: var(--space-sm);
    font-weight: 700;
    color: var(--color-brand-red);
  }

  .city-card h2 {
    font-size: 2.0rem;
  }

  .coming-soon-badge {
    display: inline-block;
    margin-bottom: var(--space-xs);
    padding: 0.2rem 0.8rem;
    background: var(--color-border);
    color: var(--color-muted);
    font-size: 1.2rem;
    font-weight: 700;
    border-radius: var(--radius-sm, 0.4rem);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }
</style>
