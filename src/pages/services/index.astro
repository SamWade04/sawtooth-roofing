---
import { getCollection } from 'astro:content';
import { Picture } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import SectionBand from '../../components/ui/SectionBand.astro';
import PhotoHeroBand from '../../components/ui/PhotoHeroBand.astro';
import heroPhoto from '../../assets/ai/ai-roof-aerial-05.png';
// Round 3b: same source Home reads, so the two grids cannot drift apart.
import { serviceTileImages, serviceTileSummaries } from '../../serviceTiles';

const services = (await getCollection('services', ({ data }) => !data.hidden)).sort(
  (a, b) => a.data.order - b.data.order
);
---

<BaseLayout
  title="Our Services | Sawtooth Roofing"
  description="Treasure Valley storm- and hail-damage insurance-restoration specialist. We start with a free, no-obligation inspection that tells you where you stand, in writing."
>
  <!-- main.services-hub is a plain flow container; bands own all width/padding/surface -->
  <main class="services-hub">

    {/* Stage 3b Round 3: interior photo header (0.78 overlay, centered H1 only).
        This hub sits on SectionBand rather than ContentPageLayout, so PhotoHeroBand
        is used directly — no layout restructure. The lead below moved here from
        the old dark band, byte-identical. */}
    <PhotoHeroBand
      image={heroPhoto}
      alt="top-down view of a geometric residential roof pattern"
      heading="Our Services"
    />

    <SectionBand surface="light" width="content" pad="band">
      <p class="lead u-reading">
        Sawtooth Roofing is the Treasure Valley's storm- and hail-damage insurance-restoration specialist. Whether a storm just hit or your roof has simply reached the end of its life, we start the same way — with a free, no-obligation inspection that tells you exactly where you stand, in writing.
      </p>

      <p class="services-hub-sub u-reading">
        Below are our core roofing services. When storm damage is involved, we also document it for your insurance claim and work with your insurer through the restoration — you stay in control of your claim, start to finish.
      </p>

      <ul class="service-grid">
        {
          services.map((service) =>
            service.data.draft ? (
              /* Any draft, non-hidden entry renders as an unlinked coming-soon card.
                 Round 3b adds the photo; the existing --draft opacity dims the whole
                 card, image included. Badge and draft copy are untouched. */
              <li class="service-card service-card--draft">
                <div class="service-card-link service-card-link--draft">
                  {serviceTileImages[service.id] && (
                    <figure class="service-card-media">
                      <Picture
                        src={serviceTileImages[service.id].src}
                        alt={serviceTileImages[service.id].alt}
                        formats={['avif', 'webp']}
                        fallbackFormat="jpeg"
                        widths={[400, 800]}
                        sizes="(min-width: 768px) 33vw, 100vw"
                        loading="lazy"
                        decoding="async"
                      />
                    </figure>
                  )}
                  <span class="draft-badge">DRAFT — coming soon</span>
                  <h2>{service.data.title}</h2>
                  <p>{service.data.summary}</p>
                </div>
              </li>
            ) : (
              <li class="service-card">
                <a href={`/services/${service.id}`} class="service-card-link">
                  <figure class="service-card-media">
                    <Picture
                      src={serviceTileImages[service.id].src}
                      alt={serviceTileImages[service.id].alt}
                      formats={['avif', 'webp']}
                      fallbackFormat="jpeg"
                      widths={[400, 800]}
                      sizes="(min-width: 768px) 33vw, 100vw"
                      loading="lazy"
                      decoding="async"
                    />
                  </figure>
                  <h2>{service.data.title}</h2>
                  <p>{serviceTileSummaries[service.id]}</p>
                  <span class="service-card-cta">Learn more &rarr;</span>
                </a>
              </li>
            )
          )
        }
      </ul>
    </SectionBand>

  </main>
</BaseLayout>

<style>
  /* Relocated out of the old dark hero band — it now opens the body, so the
     interior answer-first pattern applies: no top margin, gap below to the
     sub-paragraph that follows. */
  .lead {
    margin-bottom: var(--space-md);
  }

  .service-grid {
    list-style: none;
    padding: 0;
    margin: var(--space-lg) 0 0;
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-sm);
  }

  @media (min-width: 768px) {
    .service-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  .service-card {
    display: flex;
  }

  /* Round 3b: column flex + auto-margin CTA, matching the Home tile, so the
     "Learn more" links sit on a common baseline whatever the copy length. */
  .service-card-link {
    display: flex;
    flex-direction: column;
    width: 100%;
    padding: var(--space-md);
    background: var(--color-card);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md); /* snapped: 0.6rem → 0.8rem */
    text-decoration: none;
  }

  /* Hover-lift scoped to interactive (non-draft) cards; compositor-only props; zero CLS */
  .service-card-link:not(.service-card-link--draft) {
    transition: transform var(--duration-base) var(--ease-out),
                box-shadow var(--duration-base) var(--ease-out),
                border-color var(--duration-base) var(--ease-out);
  }

  .service-card-link:not(.service-card-link--draft):hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow-lg);
    border-color: var(--color-border-strong);
  }

  /* Photo bleeds to the card's top corners — same negative-margin pull and
     16:9 reservation as the Home tile (CLS-safe: the ratio holds the box). */
  .service-card-media {
    margin: calc(var(--space-md) * -1) calc(var(--space-md) * -1) var(--space-sm);
    aspect-ratio: 16 / 9;
    overflow: hidden;
    border-radius: var(--radius-md) var(--radius-md) 0 0;
  }

  .service-card-media :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* Display title — plain h2 register, matching the Home tile. The previous
     2.0rem override is gone so both grids share one type scale. */
  .service-card h2 {
    margin-bottom: var(--space-xs);
  }

  .service-card p {
    margin-top: var(--space-xs);
  }

  .service-card-cta {
    margin-top: auto;
    padding-top: var(--space-sm);
    font-weight: 700;
    font-size: 1.4rem;
    color: var(--color-brand-red);
  }

  .service-card--draft .service-card-link--draft {
    opacity: 0.6;
    cursor: default;
    pointer-events: none;
  }

  .draft-badge {
    display: inline-block;
    /* The card is now a flex column, which would blockify this and stretch the
       pill background across the full card width — keep it hugging its text. */
    align-self: flex-start;
    margin-bottom: var(--space-xs);
    padding: 0.2rem 0.8rem;
    background: var(--color-border);
    color: var(--color-muted);
    font-size: 1.2rem;
    font-weight: 700;
    border-radius: var(--radius-sm, 0.4rem);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }
</style>
