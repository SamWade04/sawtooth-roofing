---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Contact | Sawtooth Roofing"
  description="TODO[A3-content]: contact meta description, canon-sourced."
>
  <main class="contact-page">
    <h1>Contact</h1>

    <!-- Canon NAP block -->
    <address class="contact-nap">
      <p class="contact-brand">Sawtooth Roofing</p>
      <p>1560 S Carol St<br />Meridian, ID 83646</p>
      <p><a href="tel:+12089968748" class="contact-phone">208.996.8748</a></p>
      <!-- TODO[A3-content]: email slot — retired customs.com domain intentionally omitted; add canon email when available. -->
    </address>

    {/* A6 refactors this into a reusable CLS-safe GHLFormEmbed.astro */}
    <div class="ghl-form-wrap">
      <iframe
        src="https://api.leadconnectorhq.com/widget/form/509nlDsN02SsN7H7Q7os"
        title="Contact Sawtooth Roofing"
        class="ghl-form-iframe"
        loading="lazy"
      ></iframe>
    </div>

    <script is:inline src="https://link.msgsndr.com/js/form_embed.js"></script>
  </main>
</BaseLayout>

<style>
  .contact-page {
    max-width: 72rem;
    margin: var(--space-lg) auto;
    padding: 0 var(--space-md);
  }

  .contact-nap {
    font-style: normal;
    margin-top: var(--space-sm);
  }

  .contact-brand {
    font-weight: 700;
    color: var(--color-headline);
  }

  .contact-nap p {
    margin-top: var(--space-2xs);
  }

  .contact-phone {
    font-weight: 700;
    color: var(--color-brand-red);
    text-decoration: none;
  }

  .contact-phone:hover {
    color: var(--color-brand-red-hover);
  }

  /* CLS-safe container: reserves vertical space before the iframe loads. */
  .ghl-form-wrap {
    margin-top: var(--space-lg); /* snapped: 3.2rem → 4.0rem */
    min-height: 60rem;
  }

  .ghl-form-iframe {
    width: 100%;
    min-height: 60rem;
    border: 0;
    border-radius: var(--radius-sm);
  }
</style>
