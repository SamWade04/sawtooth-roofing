---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionBand from '../components/ui/SectionBand.astro';
import GHLBookingEmbed from '../components/forms/GHLBookingEmbed.astro';
---

<BaseLayout
  title="Contact | Sawtooth Roofing"
  description="TODO[A3-content]: contact meta description, canon-sourced."
>
  <!-- main.contact-page is a plain flow container; bands own all width/padding/surface -->
  <main class="contact-page">

    <SectionBand surface="dark" width="content" pad="band">
      <h1>Contact</h1>
    </SectionBand>

    <SectionBand surface="light" width="content" pad="band">
      <!-- Placed before the widget markup so the embed activates right after
           DOMContentLoaded, not after the whole page parses (A6 hoist fix). -->
      <script is:inline src="https://link.msgsndr.com/js/form_embed.js" defer></script>

      <GHLBookingEmbed
        calendarId="uEQ7viDh1491uAGd9kAJ"
        embedId="pENu8WZrTGtbt1G2TqZe_1784587881017"
        title="Book a free roof inspection"
        minHeight="152rem"
        minHeightWide="80rem"
        loading="eager"
      />

      <div class="contact-info-row">

        <!-- Canon NAP block -->
        <address class="contact-nap">
          <p class="contact-brand">Sawtooth Roofing</p>
          <p>1560 S Carol St<br />Meridian, ID 83646</p>
          <p><a href="tel:+12089968748" class="contact-phone">208.996.8748</a></p>
          <p>Open 8:00 AM&ndash;9:00 PM daily</p>
          <!-- TODO[A3-content]: email slot — retired customs.com domain intentionally omitted; add canon email when available. -->
        </address>

      </div>
    </SectionBand>

  </main>
</BaseLayout>

<style>
  .contact-info-row {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-lg);
    margin-top: var(--space-lg);
  }

  @media (min-width: 768px) {
    .contact-info-row {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .contact-nap {
    font-style: normal;
  }

  .contact-brand {
    font-weight: 700;
    color: var(--color-headline);
  }

  .contact-nap p {
    margin-top: var(--space-2xs);
  }

  .contact-phone {
    font-weight: 700;
    color: var(--color-brand-red);
    text-decoration: none;
  }

  .contact-phone:hover {
    color: var(--color-brand-red-hover);
  }
</style>
