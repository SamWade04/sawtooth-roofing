---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionBand from '../components/ui/SectionBand.astro';
import PhotoHeroBand from '../components/ui/PhotoHeroBand.astro';
import GHLBookingEmbed from '../components/forms/GHLBookingEmbed.astro';
import heroPhoto from '../assets/ai/ai-neighborhood-03.png';
import { GBP_URL } from '../consts';
---

<BaseLayout
  title="Contact | Sawtooth Roofing"
  description="Book a free roof inspection with Sawtooth Roofing. Serving Nampa, Caldwell, Meridian, Boise & Kuna — call 208.996.8748 or schedule online."
>
  <!-- main.contact-page is a plain flow container; bands own all width/padding/surface -->
  <main class="contact-page">

    {/* Round 3b: standard interior photo header (0.78 overlay, centered H1 only).
        This page sits on BaseLayout + SectionBand rather than ContentPageLayout,
        so PhotoHeroBand is used directly — same approach as the two hubs, no
        layout restructure. The old dark band held the H1 and nothing else, so
        there was no intro prose to relocate. */}
    <PhotoHeroBand
      image={heroPhoto}
      alt="residential neighborhood street lined with houses"
      heading="Contact"
    />

    <SectionBand surface="light" width="content" pad="band" class="contact-band">
      <!-- Placed before the widget markup so the embed activates right after
           DOMContentLoaded, not after the whole page parses (A6 hoist fix). -->
      <script is:inline src="https://link.msgsndr.com/js/form_embed.js" defer></script>

      <div class="contact-cards">

        <div class="contact-card">
          <svg class="contact-card-icon" viewBox="0 0 20 20" aria-hidden="true" focusable="false">
            <path
              d="M2 3a1.5 1.5 0 0 1 1.5-1.5h1.8c.6 0 1.1.4 1.3 1l.9 2.7a1.5 1.5 0 0 1-.4 1.6L6 7.8c.9 1.8 2.4 3.3 4.2 4.2l1-1.1a1.5 1.5 0 0 1 1.6-.4l2.7.9c.6.2 1 .7 1 1.3v1.8A1.5 1.5 0 0 1 15 16C7.8 16 2 10.2 2 3Z"
              fill="currentColor"
            />
          </svg>
          <p class="contact-card-label">Phone</p>
          <p class="contact-card-value">
            <a href="tel:+12089968748" class="contact-card-phone">208.996.8748</a>
          </p>
          <p class="contact-card-sub">Open 8:00 AM&ndash;9:00 PM daily</p>
        </div>

        <div class="contact-card">
          <svg class="contact-card-icon" viewBox="0 0 20 20" aria-hidden="true" focusable="false">
            <rect x="2" y="4" width="16" height="12" rx="1.5" fill="none" stroke="currentColor" stroke-width="1.5" />
            <path d="M2.5 5 L10 11 L17.5 5" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
          <p class="contact-card-label">Email</p>
          <p class="contact-card-value">
            <a href="mailto:contact@sawtooth-roofing.com" class="contact-card-email">contact@sawtooth-roofing.com</a>
          </p>
        </div>

        <div class="contact-card">
          <svg class="contact-card-icon" viewBox="0 0 20 20" aria-hidden="true" focusable="false">
            <path
              d="M10 18s6-6.5 6-10.5A6 6 0 0 0 4 7.5C4 11.5 10 18 10 18Z"
              fill="none"
              stroke="currentColor"
              stroke-width="1.5"
              stroke-linejoin="round"
            />
            <circle cx="10" cy="7.5" r="2" fill="currentColor" />
          </svg>
          <p class="contact-card-label">Address</p>
          <p class="contact-card-value">
            <a href={GBP_URL} target="_blank" rel="noopener" class="contact-card-address-link">
              1560 S Carol St<br />Meridian, ID 83646
            </a>
          </p>
        </div>

      </div>

      <h2>Book a free roof inspection</h2>

      <GHLBookingEmbed
        calendarId="uEQ7viDh1491uAGd9kAJ"
        embedId="pENu8WZrTGtbt1G2TqZe_1784587881017"
        title="Book a free roof inspection"
        minHeight="142rem"
        minHeightWide="130rem"
        loading="eager"
      />
    </SectionBand>

  </main>
</BaseLayout>

<style>
  /* :has() reaches the SectionBand's own outer .band--pad-band section from
     here, since .contact-band (below) lands on its inner .band-inner div —
     avoids touching SectionBand.astro while stepping this band's top padding
     down one level on the --space-* scale; bottom padding is untouched. */
  :global(section.band--pad-band:has(> .contact-band)) {
    padding-block-start: var(--space-lg);
  }

  @media (min-width: 768px) {
    :global(section.band--pad-band:has(> .contact-band)) {
      padding-block-start: var(--space-xl);
    }
  }

  .contact-cards {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-md);
  }

  @media (min-width: 768px) {
    .contact-cards {
      grid-template-columns: 1fr 1fr 1fr;
    }
  }

  /* Card treatment reused verbatim from the Home service-card pattern
     (background/border/radius/padding tokens) — no hover-lift, these are
     informational, not navigational. */
  .contact-card {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    padding: var(--space-md);
    background: var(--color-card);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
  }

  .contact-card-icon {
    width: 2.4rem;
    height: 2.4rem;
    color: var(--color-brand-red);
    margin-bottom: var(--space-xs);
  }

  .contact-card-label {
    margin: 0;
    font-size: 1.3rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-muted);
  }

  .contact-card-value {
    margin: var(--space-2xs) 0 0;
  }

  .contact-card-phone {
    font-size: 2.0rem;
    font-weight: 700;
    color: var(--color-brand-red);
    text-decoration: none;
  }

  .contact-card-phone:hover {
    color: var(--color-brand-red-hover);
  }

  .contact-card-sub {
    margin: var(--space-2xs) 0 0;
    font-size: 1.4rem;
    color: var(--color-body);
  }

  .contact-card-email {
    font-size: 1.5rem;
    color: var(--color-brand-red);
    text-decoration: none;
    overflow-wrap: anywhere;
  }

  .contact-card-email:hover {
    color: var(--color-brand-red-hover);
  }

  .contact-card-address-link {
    font-size: 1.5rem;
    color: var(--color-body);
    text-decoration: none;
  }

  .contact-card-address-link:hover {
    color: var(--color-brand-red);
  }

  @media (min-width: 768px) {
    .contact-card-label {
      font-size: 1.4rem;
    }

    .contact-card-phone {
      font-size: 2.4rem;
    }

    .contact-card-sub {
      font-size: 1.6rem;
    }

    .contact-card-email,
    .contact-card-address-link {
      font-size: 1.8rem;
    }
  }

  h2 {
    margin-top: var(--space-lg);
    text-align: center;
  }

  /* GHLBookingEmbed's own wrapper carries no top margin — reach into its
     scoped markup rather than adding padding-top to the widget wrapper
     itself (same :global() pattern used in ContentPageLayout for the rail
     form's height override). 76rem keeps the widget's container below GHL's
     982px layout threshold at every viewport, forcing its stacked variant
     (full content height, no internal scrollbar) instead of the side-by-side
     variant that hard-caps at 700px with an internal scroll. */
  :global(.ghl-booking-wrap) {
    margin-top: var(--space-lg);
    max-width: 76rem;
    margin-inline: auto;
  }
</style>
