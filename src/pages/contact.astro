---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionBand from '../components/ui/SectionBand.astro';
import GHLBookingEmbed from '../components/forms/GHLBookingEmbed.astro';
---

<BaseLayout
  title="Contact | Sawtooth Roofing"
  description="TODO[A3-content]: contact meta description, canon-sourced."
>
  <!-- main.contact-page is a plain flow container; bands own all width/padding/surface -->
  <main class="contact-page">

    <SectionBand surface="dark" width="content" pad="band">
      <h1>Contact</h1>
    </SectionBand>

    <SectionBand surface="light" width="content" pad="band" class="contact-band">
      <!-- Placed before the widget markup so the embed activates right after
           DOMContentLoaded, not after the whole page parses (A6 hoist fix). -->
      <script is:inline src="https://link.msgsndr.com/js/form_embed.js" defer></script>

      <div class="contact-layout">

        <GHLBookingEmbed
          calendarId="uEQ7viDh1491uAGd9kAJ"
          embedId="pENu8WZrTGtbt1G2TqZe_1784587881017"
          title="Book a free roof inspection"
          minHeight="152rem"
          minHeightMid="80rem"
          minHeightWide="98rem"
          loading="eager"
        />

        <div class="contact-rail">

          <!-- Canon NAP block -->
          <address class="contact-nap">
            <p class="contact-brand">Sawtooth Roofing</p>
            <p>1560 S Carol St<br />Meridian, ID 83646</p>
            <p><a href="tel:+12089968748" class="contact-phone">208.996.8748</a></p>
            <p><a href="mailto:contact@sawtooth-roofing.com" class="contact-phone">contact@sawtooth-roofing.com</a></p>
            <p>Open 8:00 AM&ndash;9:00 PM daily</p>
          </address>

        </div>

      </div>
    </SectionBand>

  </main>
</BaseLayout>

<style>
  /* :has() reaches the SectionBand's own outer .band--pad-band section from
     here, since .contact-band (below) lands on its inner .band-inner div —
     avoids touching SectionBand.astro while stepping this band's top padding
     down one level on the --space-* scale; bottom padding is untouched. */
  :global(section.band--pad-band:has(> .contact-band)) {
    padding-block-start: var(--space-lg);
  }

  @media (min-width: 768px) {
    :global(section.band--pad-band:has(> .contact-band)) {
      padding-block-start: var(--space-xl);
    }
  }

  .contact-layout {
    display: grid;
    grid-template-columns: 1fr;
  }

  @media (min-width: 1200px) {
    .contact-layout {
      grid-template-columns: 1fr var(--rail-width);
      gap: var(--space-lg);
      align-items: start;
    }
  }

  .contact-rail {
    margin-top: var(--space-lg);
    background: var(--color-card);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    padding: var(--space-md);
  }

  @media (min-width: 1200px) {
    .contact-rail {
      margin-top: 0;
      position: sticky;
      top: var(--space-lg);
    }
  }

  .contact-nap {
    font-style: normal;
  }

  .contact-brand {
    font-weight: 700;
    color: var(--color-headline);
  }

  .contact-nap p {
    margin-top: var(--space-2xs);
  }

  .contact-phone {
    font-weight: 700;
    color: var(--color-brand-red);
    text-decoration: none;
  }

  .contact-phone:hover {
    color: var(--color-brand-red-hover);
  }
</style>
