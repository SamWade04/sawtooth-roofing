---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionBand from '../components/ui/SectionBand.astro';
import GHLBookingEmbed from '../components/forms/GHLBookingEmbed.astro';
---

<BaseLayout
  title="Contact | Sawtooth Roofing"
  description="TODO[A3-content]: contact meta description, canon-sourced."
>
  <!-- main.contact-page is a plain flow container; bands own all width/padding/surface -->
  <main class="contact-page">

    <SectionBand surface="dark" width="content" pad="band">
      <h1>Contact</h1>
    </SectionBand>

    <SectionBand surface="light" width="content" pad="band" class="contact-band">
      <!-- Placed before the widget markup so the embed activates right after
           DOMContentLoaded, not after the whole page parses (A6 hoist fix). -->
      <script is:inline src="https://link.msgsndr.com/js/form_embed.js" defer></script>

      <h2>Book a free roof inspection</h2>

      <ul class="contact-nap-line">
        <li class="contact-nap-item">Sawtooth Roofing</li>
        <li class="contact-nap-item contact-nap-sep" aria-hidden="true">&middot;</li>
        <li class="contact-nap-item">1560 S Carol St, Meridian, ID 83646</li>
        <li class="contact-nap-item contact-nap-sep" aria-hidden="true">&middot;</li>
        <li class="contact-nap-item">
          <a href="tel:+12089968748" class="contact-nap-phone">208.996.8748</a>
        </li>
        <li class="contact-nap-item contact-nap-sep" aria-hidden="true">&middot;</li>
        <li class="contact-nap-item">
          <a href="mailto:contact@sawtooth-roofing.com" class="contact-nap-email">contact@sawtooth-roofing.com</a>
        </li>
        <li class="contact-nap-item contact-nap-sep" aria-hidden="true">&middot;</li>
        <li class="contact-nap-item">Open 8:00 AM&ndash;9:00 PM daily</li>
      </ul>

      <GHLBookingEmbed
        calendarId="uEQ7viDh1491uAGd9kAJ"
        embedId="pENu8WZrTGtbt1G2TqZe_1784587881017"
        title="Book a free roof inspection"
        minHeight="142rem"
        minHeightWide="78rem"
        loading="eager"
      />
    </SectionBand>

  </main>
</BaseLayout>

<style>
  /* :has() reaches the SectionBand's own outer .band--pad-band section from
     here, since .contact-band (below) lands on its inner .band-inner div —
     avoids touching SectionBand.astro while stepping this band's top padding
     down one level on the --space-* scale; bottom padding is untouched. */
  :global(section.band--pad-band:has(> .contact-band)) {
    padding-block-start: var(--space-lg);
  }

  @media (min-width: 768px) {
    :global(section.band--pad-band:has(> .contact-band)) {
      padding-block-start: var(--space-xl);
    }
  }

  .contact-nap-line {
    list-style: none;
    margin: var(--space-xs) 0 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    justify-content: flex-start;
    gap: var(--space-2xs) var(--space-sm);
  }

  .contact-nap-item {
    font-size: 1.4rem;
    color: var(--color-muted);
  }

  .contact-nap-sep {
    color: var(--color-border-strong);
  }

  .contact-nap-phone {
    font-weight: 700;
    color: var(--color-brand-red);
    text-decoration: none;
  }

  .contact-nap-phone:hover {
    color: var(--color-brand-red-hover);
  }

  .contact-nap-email {
    color: var(--color-muted);
    text-decoration: none;
  }

  .contact-nap-email:hover {
    color: var(--color-brand-red);
  }

  /* GHLBookingEmbed's own wrapper carries no top margin — reach into its
     scoped markup rather than adding padding-top to the widget wrapper
     itself (same :global() pattern used in ContentPageLayout for the rail
     form's height override). */
  :global(.ghl-booking-wrap) {
    margin-top: var(--space-xs);
  }
</style>
