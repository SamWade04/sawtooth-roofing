---
import BaseLayout from '../layouts/BaseLayout.astro';
import PhotoHeroBand from '../components/ui/PhotoHeroBand.astro';
import SectionBand from '../components/ui/SectionBand.astro';
import PageTailCTA from '../components/ui/PageTailCTA.astro';
import neighborhood from '../assets/ai/ai-neighborhood-01.png';
import { GBP_URL } from '../consts';

const LEAD =
  "Sawtooth Roofing is an Idaho-registered roofing contractor based in Meridian, specializing in storm- and hail-damage insurance-restoration roofing across the Treasure Valley. When a storm moves through Nampa, Caldwell, Meridian, Boise, or Kuna, we're the local crew homeowners call to inspect the damage, document it for their insurance claim, and rebuild the roof right.";
---

<BaseLayout
  title="About Sawtooth Roofing — Treasure Valley Insurance-Restoration Roofers"
  description="Sawtooth Roofing is an Idaho-registered, Meridian-based roofing contractor specializing in storm- and hail-damage insurance restoration across the Treasure Valley."
>
  <main class="content-page">

    <PhotoHeroBand image={neighborhood} alt="suburban neighborhood rooftops" heading="About" />

    <SectionBand surface="light" width="reading" pad="band">
      <div class="content-main">
        <p class="lead u-reading">{LEAD}</p>

        <h2>About Sawtooth Roofing</h2>

        <h3>What we do</h3>
        <p>We focus on three core services — <strong>roof replacement, roof repair, and storm-damage restoration</strong> — wrapped by the work that defines us: helping homeowners through the insurance-restoration process. We inspect, we document, we work with your insurance, and we complete the approved repairs. You stay in control of your claim throughout.</p>

        <h3>Why we specialize in insurance restoration</h3>
        <p>The Treasure Valley gets real weather — hail and high wind that does real damage to roofs. Because the majority of our work is storm and insurance restoration, the parts of the job that are occasional for a general contractor are routine for us: thorough damage documentation, on-site adjuster meetings, and manufacturer-spec rebuilds. That focus is the point. It means a homeowner dealing with a damaged roof and an insurance claim is working with a crew that does this every week, not once in a while.</p>

        <h3>Products and partners</h3>
        <p>We source materials through <strong>ABC Supply</strong> and <strong>Pacific Supply</strong> — quality systems installed to manufacturer specification, built for Idaho's climate.</p>

        <h3>Proof, not promises</h3>
        <p>We let the work speak. Sawtooth Roofing holds a <strong>5.0 average across 83 Google reviews</strong> — see them for yourself on our <a href={GBP_URL} target="_blank" rel="noopener">Google Business Profile</a>.</p>

        <h3>The team</h3>
        <p>Sawtooth Roofing &amp; Construction LLC is owner-led by a small, hands-on team:</p>
        <ul>
          <li><strong>Joshua Morrow — Co-Owner.</strong> Oversees production and site quality, and inspects roofs personally from estimate to final walkthrough.</li>
          <li><strong>Anthony Leiser — Co-Owner.</strong> Coordinates each project's insurance-restoration steps and meets adjusters on-site, keeping documentation accurate for the homeowner's claim.</li>
          <li><strong>Sam Wade — Director of Systems and Marketing.</strong> Oversees Sawtooth's marketing and internal systems, coordinating the scheduling and tools that keep each job on track.</li>
          <li><strong>Kim Williams — Claims Handler.</strong> Schedules inspections and adjuster meetings and keeps homeowners' claim paperwork organized and on track.</li>
        </ul>

        <h3>Where we work</h3>
        <p>We serve homeowners across the Treasure Valley from our Meridian base: <strong>Nampa, Caldwell, Meridian, Boise, and Kuna.</strong></p>

        <p><strong>Storm damage, a stubborn leak, or a roof near the end of its life? <a href="/contact">Book a free roof inspection</a> — no obligation, straight answers.</strong></p>
      </div>
    </SectionBand>

    {/* The body band directly above is also light, so this one carries the seam. */}
    <PageTailCTA divider="top" />

  </main>
</BaseLayout>

<style>
  .content-main {
    max-width: var(--reading-width);
  }

  .content-main .lead {
    margin-bottom: var(--space-md);
  }

  .content-main h2 {
    margin-top: 0;
  }

  .content-main h3 {
    margin-top: var(--space-md);
  }

  .content-main h2:first-child,
  .content-main h3:first-child {
    margin-top: 0;
  }

  .content-main p {
    margin-top: var(--space-sm);
  }

  .content-main ul {
    margin-top: var(--space-sm);
    padding-left: var(--space-md);
  }

  .content-main li {
    margin-top: var(--space-xs);
  }

  .content-main a {
    color: var(--color-brand-red);
    font-weight: 600;
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  .content-main a:hover {
    color: var(--color-brand-red-hover);
  }

  .content-main a:focus-visible {
    outline: 2px solid var(--color-brand-red);
    outline-offset: 2px;
  }
</style>
