---
// A3.6 — shared composed content-page primitive (hero band + body band).
// On-dark text is handled entirely by the global .band--dark cascade — no color rules here.
import type { ImageMetadata } from 'astro';
import { Picture } from 'astro:assets';
import BaseLayout from './BaseLayout.astro';
import SectionBand from '../components/ui/SectionBand.astro';
import PhotoHeroBand from '../components/ui/PhotoHeroBand.astro';
import GHLFormEmbed from '../components/forms/GHLFormEmbed.astro';

interface Props {
  title: string;          // → BaseLayout → SeoHead
  description?: string;
  heading: string;        // hero H1 — always verbatim existing copy
  eyebrow?: string;       // optional; when absent, render nothing
  lead?: string;          // optional; when absent, render nothing
  heroSurface?: 'dark' | 'light';
  heroImage?: { src: ImageMetadata; alt: string }; // full-bleed photo band instead of the solid band
  images?: { src: ImageMetadata; alt: string; role: string }[];
  asideSlot?: boolean;    // A6 form-rail placeholder
}

const {
  title,
  description,
  heading,
  eyebrow,
  lead,
  heroSurface = 'dark',
  heroImage,
  images = [],
  asideSlot = false,
} = Astro.props;
---

<BaseLayout title={title} description={description}>
  <main class="content-page">

    {heroImage ? (
      <PhotoHeroBand image={heroImage.src} alt={heroImage.alt} heading={heading} />
    ) : (
      <SectionBand surface={heroSurface} width="content" pad="band">
        <div class="content-hero">
          {eyebrow && <p class="eyebrow">{eyebrow}</p>}
          <h1>{heading}</h1>
          {lead && <p class="lead u-reading">{lead}</p>}
        </div>
      </SectionBand>
    )}

    <SectionBand surface="light" width={asideSlot ? 'content' : 'reading'} pad="band">
      {
        asideSlot ? (
          <div class="content-body-grid">
            {/* Placed before the rail's form markup so the embed activates right
                after DOMContentLoaded, not after the whole page parses (A6 hoist fix). */}
            <script is:inline src="https://link.msgsndr.com/js/form_embed.js" defer></script>

            <div class="content-main">
              {/* Photo-header pages relocate the lead here, verbatim, as the
                  answer-first opening — the band above carries the H1 only. */}
              {heroImage && lead && <p class="lead u-reading">{lead}</p>}
              {images.map((img, index) => (
                <figure class="content-media" style={`aspect-ratio: ${img.src.width} / ${img.src.height}`}>
                  <Picture
                    src={img.src}
                    alt={img.alt}
                    formats={['avif', 'webp']}
                    fallbackFormat="jpeg"
                    widths={[400, 800, 1200, 1600]}
                    sizes="(min-width: 1135px) 68rem, (min-width: 768px) calc(100vw - 45.5rem), 100vw"
                    loading={index === 0 ? 'eager' : 'lazy'}
                    decoding="async"
                    fetchpriority={index === 0 ? 'high' : undefined}
                  />
                </figure>
              ))}
              <slot />
            </div>
            <aside class="content-rail">
              <p class="content-rail-heading">Request a free inspection</p>
              {/* Stage 3b Round 3: desktopOnly — the rail iframe is absent from the
                  initial HTML below 768px, same mechanism as the home hero form.
                  Sam accepted the tradeoff: this removes the mobile form-fill path
                  from the service pages; mobile conversion is the fixed call bar
                  and the tail CTA to /contact. */}
              <GHLFormEmbed
                formId="lS0Y9yigL7YY609WmWYG"
                title="Request a free inspection"
                minHeight="120rem"
                loading="eager"
                desktopOnly
              />
            </aside>
          </div>
        ) : (
          <div class="content-main">
            {heroImage && lead && <p class="lead u-reading">{lead}</p>}
            {images.map((img, index) => (
              <figure class="content-media" style={`aspect-ratio: ${img.src.width} / ${img.src.height}`}>
                <Picture
                  src={img.src}
                  alt={img.alt}
                  formats={['avif', 'webp']}
                  fallbackFormat="jpeg"
                  widths={[400, 800, 1200, 1600]}
                  sizes="(min-width: 1135px) 68rem, (min-width: 768px) calc(100vw - 45.5rem), 100vw"
                  loading={index === 0 ? 'eager' : 'lazy'}
                  decoding="async"
                  fetchpriority={index === 0 ? 'high' : undefined}
                />
              </figure>
            ))}
            <slot />
          </div>
        )
      }
    </SectionBand>

    <slot name="after" />

  </main>
</BaseLayout>

<style>
  /* ── HERO (spacing mirrors Home hero; colors via global .band--dark cascade) ── */
  .content-hero .eyebrow {
    margin-bottom: var(--space-sm);
  }

  .content-hero .lead {
    margin-top: var(--space-sm);
  }

  /* ── BODY grid: reading column + aside rail (rail stacks below on mobile) ── */
  .content-body-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-lg);
  }

  @media (min-width: 768px) {
    .content-body-grid {
      grid-template-columns: minmax(0, 1fr) var(--rail-width);
      align-items: start;
    }
  }

  /* Text column stays reading-capped even inside a content-width band */
  .content-main {
    max-width: var(--reading-width);
  }

  /* ── content media — CLS-safe: aspect-ratio is set inline per-image from its own
     intrinsic width/height, so this stays portrait-capable, not 16:9-locked ── */
  .content-media {
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    overflow: hidden;
    margin-bottom: var(--space-lg);
  }

  .content-media :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* ── A6 form rail ──
     Round 3: the rail is desktopOnly, so the whole aside is hidden below
     768px — not just the iframe. Same pattern as the home hero's .hero-form.
     Without this the reserved min-height below would hold ~650px of empty
     space open on mobile, under an orphaned "Request a free inspection"
     heading, for a form that is deliberately never mounted there. */
  .content-rail {
    display: none;
  }

  @media (min-width: 768px) {
    .content-rail {
      display: block;
    }
  }

  /* micro-form eyebrow */
  .content-rail-heading {
    margin-bottom: var(--space-sm);
    font-weight: 700;
    color: var(--color-headline);
  }

  /* Rail form's reserved floor. The rail no longer renders at all below 768px
     (see .content-rail above), so only the desktop floor is needed — it matches
     the form's ~1156px natural height there. :global reaches into the child
     component's scoped markup; the extra `aside.content-rail` specificity wins
     deterministically over GHLFormEmbed's own scoped rule without !important. */
  @media (min-width: 768px) {
    aside.content-rail :global(.ghl-form-wrap),
    aside.content-rail :global(.ghl-form-iframe) {
      min-height: 120rem;
    }
  }

  /* ── Prose rhythm for slotted markdown — the global reset zeroes these margins
     and nothing restores them for rendered <Content />; tokens only, mirrors About ── */
  .content-main :global(h2) {
    margin-top: var(--space-lg);
  }

  .content-main :global(h3) {
    margin-top: var(--space-md);
  }

  .content-main :global(p) {
    margin-top: var(--space-sm);
  }

  .content-main :global(ul),
  .content-main :global(ol) {
    margin-top: var(--space-sm);
    padding-left: var(--space-md);
  }

  .content-main :global(li) {
    margin-top: var(--space-xs);
  }

  .content-main > :global(:first-child),
  .content-main :global(h2:first-child) {
    margin-top: 0;
  }

  .content-main :global(a) {
    color: var(--color-brand-red);
    font-weight: 600;
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  .content-main :global(a:hover) {
    color: var(--color-brand-red-hover);
  }

  .content-main :global(a:focus-visible) {
    outline: 2px solid var(--color-brand-red);
    outline-offset: 2px;
  }
</style>
