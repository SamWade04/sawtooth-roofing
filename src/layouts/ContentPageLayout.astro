---
// A3.6 — shared composed content-page primitive (hero band + body band).
// On-dark text is handled entirely by the global .band--dark cascade — no color rules here.
import type { ImageMetadata } from 'astro';
import { Picture } from 'astro:assets';
import BaseLayout from './BaseLayout.astro';
import SectionBand from '../components/ui/SectionBand.astro';
import GHLFormEmbed from '../components/forms/GHLFormEmbed.astro';

interface Props {
  title: string;          // → BaseLayout → SeoHead
  description?: string;
  heading: string;        // hero H1 — always verbatim existing copy
  eyebrow?: string;       // optional; when absent, render nothing
  lead?: string;          // optional; when absent, render nothing
  heroSurface?: 'dark' | 'light';
  images?: { src: ImageMetadata; alt: string; role: string }[];
  asideSlot?: boolean;    // A6 form-rail placeholder
}

const {
  title,
  description,
  heading,
  eyebrow,
  lead,
  heroSurface = 'dark',
  images = [],
  asideSlot = false,
} = Astro.props;
---

<BaseLayout title={title} description={description}>
  <main class="content-page">

    <SectionBand surface={heroSurface} width="content" pad="band">
      <div class="content-hero">
        {eyebrow && <p class="eyebrow">{eyebrow}</p>}
        <h1>{heading}</h1>
        {lead && <p class="lead u-reading">{lead}</p>}
      </div>
    </SectionBand>

    <SectionBand surface="light" width={asideSlot ? 'content' : 'reading'} pad="band">
      {
        asideSlot ? (
          <div class="content-body-grid">
            {/* Placed before the rail's form markup so the embed activates right
                after DOMContentLoaded, not after the whole page parses (A6 hoist fix). */}
            <script is:inline src="https://link.msgsndr.com/js/form_embed.js" defer></script>

            <div class="content-main">
              {images.map((img) => (
                <figure class="content-media" style={`aspect-ratio: ${img.src.width} / ${img.src.height}`}>
                  <Picture
                    src={img.src}
                    alt={img.alt}
                    formats={['avif', 'webp']}
                    fallbackFormat="jpeg"
                    widths={[400, 800, 1200, 1600]}
                    sizes="(min-width: 768px) min(85rem, 60vw), 100vw"
                    loading="lazy"
                    decoding="async"
                  />
                </figure>
              ))}
              <slot />
            </div>
            <aside class="content-rail">
              <p class="content-rail-heading">Request a free inspection</p>
              <GHLFormEmbed
                formId="lS0Y9yigL7YY609WmWYG"
                title="Request a free inspection"
                minHeight="120rem"
                loading="eager"
              />
            </aside>
          </div>
        ) : (
          <div class="content-main">
            {images.map((img) => (
              <figure class="content-media" style={`aspect-ratio: ${img.src.width} / ${img.src.height}`}>
                <Picture
                  src={img.src}
                  alt={img.alt}
                  formats={['avif', 'webp']}
                  fallbackFormat="jpeg"
                  widths={[400, 800, 1200, 1600]}
                  sizes="(min-width: 768px) min(85rem, 60vw), 100vw"
                  loading="lazy"
                  decoding="async"
                />
              </figure>
            ))}
            <slot />
          </div>
        )
      }
    </SectionBand>

    <slot name="after" />

  </main>
</BaseLayout>

<style>
  /* ── HERO (spacing mirrors Home hero; colors via global .band--dark cascade) ── */
  .content-hero .eyebrow {
    margin-bottom: var(--space-sm);
  }

  .content-hero .lead {
    margin-top: var(--space-sm);
  }

  /* ── BODY grid: reading column + aside rail (rail stacks below on mobile) ── */
  .content-body-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-lg);
  }

  @media (min-width: 768px) {
    .content-body-grid {
      grid-template-columns: minmax(0, 1fr) var(--rail-width);
      align-items: start;
    }
  }

  /* Text column stays reading-capped even inside a content-width band */
  .content-main {
    max-width: var(--reading-width);
  }

  /* ── content media — CLS-safe: aspect-ratio is set inline per-image from its own
     intrinsic width/height, so this stays portrait-capable, not 16:9-locked ── */
  .content-media {
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    overflow: hidden;
    margin-bottom: var(--space-lg);
  }

  .content-media :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* ── A6 form rail — micro-form eyebrow ── */
  .content-rail-heading {
    margin-bottom: var(--space-sm);
    font-weight: 700;
    color: var(--color-headline);
  }

  /* Rail form's reserved floor is responsive: the GHLFormEmbed prop sets a
     ~120rem floor for desktop (matches the form's ~1156px natural height there),
     but the form reflows much shorter on mobile — the same floor there just
     over-reserves and leaves a gap before the footer. Override min-height
     directly (:global reaches into the child component's scoped markup;
     the extra `aside.content-rail` specificity wins deterministically over
     GHLFormEmbed's own scoped rule without needing !important). */
  aside.content-rail :global(.ghl-form-wrap),
  aside.content-rail :global(.ghl-form-iframe) {
    min-height: 65rem;
  }

  @media (min-width: 768px) {
    aside.content-rail :global(.ghl-form-wrap),
    aside.content-rail :global(.ghl-form-iframe) {
      min-height: 120rem;
    }
  }

  /* ── Prose rhythm for slotted markdown — the global reset zeroes these margins
     and nothing restores them for rendered <Content />; tokens only, mirrors About ── */
  .content-main :global(h2) {
    margin-top: var(--space-lg);
  }

  .content-main :global(h3) {
    margin-top: var(--space-md);
  }

  .content-main :global(p) {
    margin-top: var(--space-sm);
  }

  .content-main :global(ul),
  .content-main :global(ol) {
    margin-top: var(--space-sm);
    padding-left: var(--space-md);
  }

  .content-main :global(li) {
    margin-top: var(--space-xs);
  }

  .content-main > :global(:first-child),
  .content-main :global(h2:first-child) {
    margin-top: 0;
  }

  .content-main :global(a) {
    color: var(--color-brand-red);
    font-weight: 600;
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  .content-main :global(a:hover) {
    color: var(--color-brand-red-hover);
  }

  .content-main :global(a:focus-visible) {
    outline: 2px solid var(--color-brand-red);
    outline-offset: 2px;
  }
</style>
