---
import '../styles/global.css';
import SeoHead from '../components/seo/SeoHead.astro';
import Header from '../components/navigation/Header.astro';
import Footer from '../components/navigation/Footer.astro';
import MobileCallBar from '../components/ui/MobileCallBar.astro';

interface Props {
  title?: string;
  description?: string;
  canonical?: string;
  ogTitle?: string;
  ogDescription?: string;
  ogType?: string;
  robots?: string;
}
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <!-- Preload only what renders above the fold: Inter 400 (body) + Outfit 700
         (the display H1 in every page hero). Inter 700 is NOT preloaded — its
         remaining roles (buttons, eyebrows, bold body) sit below the hero and
         are covered by font-display: swap + the tuned Inter Fallback.
         crossorigin is required even same-origin — omitting it causes a double-fetch. -->
    <link
      rel="preload"
      as="font"
      type="font/woff2"
      href="/fonts/inter-latin-400-normal.woff2"
      crossorigin
    />
    <link
      rel="preload"
      as="font"
      type="font/woff2"
      href="/fonts/outfit-latin-700-normal.woff2"
      crossorigin
    />

    <SeoHead {...Astro.props} />
  </head>
  <body>
    <Header />
    <slot />
    <Footer />
    <MobileCallBar />
  </body>
</html>
