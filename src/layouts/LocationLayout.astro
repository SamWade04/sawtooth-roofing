---
import type { CollectionEntry } from 'astro:content';
import ContentPageLayout from './ContentPageLayout.astro';

interface Props {
  entry: CollectionEntry<'locations'>;
}

const { entry } = Astro.props;
const { city, summary, seo } = entry.data;

// Title/description flow through BaseLayout → SeoHead (single source of <title>).
// Fallback formula is adjustable at A5.
const pageTitle = seo?.title ?? `${city} | Sawtooth Roofing`;
const pageDescription = seo?.description ?? summary;
---

<ContentPageLayout
  title={pageTitle}
  description={pageDescription}
  heading={city}
  lead={summary}
  imageSlot
  asideSlot
>
  <slot />
</ContentPageLayout>
