---
import type { CollectionEntry } from 'astro:content';
import ContentPageLayout from './ContentPageLayout.astro';
import FinancingBand from '../components/ui/FinancingBand.astro';
import PageTailCTA from '../components/ui/PageTailCTA.astro';

interface Props {
  entry: CollectionEntry<'services'>;
}

const { entry } = Astro.props;
const { title, summary, seo, financingBand, images } = entry.data;

// Title/description flow through BaseLayout → SeoHead (single source of <title>).
// Fallback formula is adjustable at A5.
const pageTitle = seo?.title ?? `${title} | Sawtooth Roofing`;
const pageDescription = seo?.description ?? summary;
---

<ContentPageLayout
  title={pageTitle}
  description={pageDescription}
  heading={title}
  lead={summary}
  images={images}
  asideSlot
>
  <slot />
  {financingBand && <FinancingBand slot="after" />}
  <PageTailCTA slot="after" />
</ContentPageLayout>
